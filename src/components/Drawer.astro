---
import { site, nav, subNav } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!-- モバイル用メニュー（ヘッダーの backdrop-filter の影響を受けないよう header の外に配置） -->
  <div class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer__panel">
    <nav aria-label="メニュー">
      <ul class="drawer__list">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
      <ul class="drawer__list drawer__list--sub">
        {subNav.map((n) => (
          <li><a href={n.href}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="drawer__info">
      <p class="drawer__tel"><span>TEL / FAX</span><a href={`tel:${site.tel}`}>{site.tel}</a></p>
      <p class="drawer__hours">{site.hours}</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="drawer__sns">
        <a href={site.sns.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={site.sns.instagram} target="_blank" rel="noopener">Instagram</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* ドロワー */
.drawer {
  position: fixed; inset: 0; z-index: 90; overflow: hidden; background: rgba(13, 63, 110, 0.35);
  opacity: 0; visibility: hidden; transition: opacity .3s var(--ease), visibility 0s linear .3s;
}
:global(body.menu-open) .drawer { opacity: 1; visibility: visible; transition: opacity .3s var(--ease); }
.drawer__panel {
  position: absolute; top: 0; right: 0; height: 100%; width: min(100%, 400px);
  background: #fff; overflow-y: auto; padding: 84px 20px 40px;
  transform: translateX(24px); transition: transform .35s var(--ease);
  padding-top: calc(84px + env(safe-area-inset-top, 0px));
}
:global(body.menu-open) .drawer__panel { transform: none; }
.drawer__list li + li { border-top: 1px solid var(--c-line); }
.drawer__list a {
  display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 8px 4px;
  color: var(--c-ink); text-decoration: none; font-weight: 500;
}
.drawer__list a::after { content: "›"; color: var(--c-accent); font-size: 1.4rem; }
.drawer__list a[aria-current="page"] { color: var(--c-primary); font-weight: 700; }
.drawer__list--sub { margin-top: 20px; padding-top: 4px; border-top: 2px solid var(--c-sky); }
.drawer__list--sub a { min-height: 48px; font-size: 0.9375rem; }
.drawer__info { margin-top: 28px; padding: 20px; border-radius: var(--radius); background: var(--c-sky-2); font-size: 0.9375rem; }
.drawer__tel { display: flex; align-items: baseline; gap: 10px; }
.drawer__tel span { font-size: 0.75rem; font-weight: 700; color: var(--c-ink-3); letter-spacing: 0.1em; }
.drawer__tel a { font-size: 1.375rem; font-weight: 700; text-decoration: none; font-variant-numeric: tabular-nums; }
.drawer__hours { font-size: 0.8125rem; color: var(--c-ink-2); }
.drawer__sns { display: flex; gap: 16px; margin-top: 10px; }
.drawer__sns a { font-weight: 700; font-size: 0.875rem; }

</style>
